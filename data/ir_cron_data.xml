<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Hourly Refresh of Open Statements -->
        <record id="ir_cron_refresh_open_statements" model="ir.cron">
            <field name="name">Sales Bonus: Refresh Open Statements</field>
            <field name="model_id" ref="model_sales_bonus_statement"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_open_statements()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Daily Lock of Closed Months -->
        <record id="ir_cron_lock_closed_months" model="ir.cron">
            <field name="name">Sales Bonus: Lock Closed Months</field>
            <field name="model_id" ref="model_sales_bonus_statement"/>
            <field name="state">code</field>
            <field name="code">model.cron_lock_closed_months()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Monthly Grid Inheritance Check -->
        <record id="ir_cron_ensure_monthly_grids" model="ir.cron">
            <field name="name">Sales Bonus: Ensure Monthly Grids</field>
            <field name="model_id" ref="model_sales_bonus_grid"/>
            <field name="state">code</field>
            <field name="code">model.cron_ensure_monthly_grids()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
