<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="sales_bonus_grid_comp_rule" model="ir.rule">
            <field name="name">Sales Bonus Grid Multi-Company</field>
            <field name="model_id" ref="model_sales_bonus_grid"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sales_bonus_grid_line_comp_rule" model="ir.rule">
            <field name="name">Sales Bonus Grid Line Multi-Company</field>
            <field name="model_id" ref="model_sales_bonus_grid_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sales_bonus_statement_comp_rule" model="ir.rule">
            <field name="name">Sales Bonus Statement Multi-Company</field>
            <field name="model_id" ref="model_sales_bonus_statement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Statement User Rules -->
        <record id="sales_bonus_statement_user_rule" model="ir.rule">
            <field name="name">Sales Bonus Statement: Personal (Salesperson)</field>
            <field name="model_id" ref="model_sales_bonus_statement"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record id="sales_bonus_statement_manager_rule" model="ir.rule">
            <field name="name">Sales Bonus Statement: Manager (All)</field>
            <field name="model_id" ref="model_sales_bonus_statement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>
    </data>
</odoo>
