<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_bonus_grid_list" model="ir.ui.view">
        <field name="name">sales.bonus.grid.list</field>
        <field name="model">sales.bonus.grid</field>
        <field name="arch" type="xml">
            <list string="Bonus Grids">
                <field name="date_month" widget="month_picker"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="revenue_basis"/>
                <field name="source_grid_id" optional="hide"/>
                <field name="statement_count" string="Statements"/>
                <field name="is_locked" widget="boolean_toggle" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sales_bonus_grid_form" model="ir.ui.view">
        <field name="name">sales.bonus.grid.form</field>
        <field name="model">sales.bonus.grid</field>
        <field name="arch" type="xml">
            <form string="Bonus Grid">
                <header>
                    <field name="is_locked" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_statements" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="statement_count" widget="statinfo" string="Statements"/>
                        </button>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert" invisible="not is_locked">
                        <i class="fa fa-lock me-2" title="Locked"/>
                        <strong>This month is locked.</strong> Grid tiers and settings cannot be edited while statements are closed.
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="grid_timing">
                            <field name="date_month" readonly="is_locked" widget="month_picker"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="is_locked"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group name="grid_rules">
                            <field name="revenue_basis" widget="radio" readonly="is_locked"/>
                            <field name="source_grid_id" invisible="not source_grid_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bonus Tiers" name="tiers">
                            <field name="line_ids" readonly="is_locked">
                                <list editable="bottom" string="Tiers">
                                    <field name="sequence" widget="handle"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name" placeholder="e.g. Tier 1 (0 to 10k)"/>
                                    <field name="revenue_from"/>
                                    <field name="revenue_to"/>
                                    <field name="bonus_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sales_bonus_grid_search" model="ir.ui.view">
        <field name="name">sales.bonus.grid.search</field>
        <field name="model">sales.bonus.grid</field>
        <field name="arch" type="xml">
            <search string="Search Bonus Grids">
                <field name="name"/>
                <field name="date_month"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="active_grids" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived_grids" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="invoiced_basis" string="Invoiced Basis" domain="[('revenue_basis', '=', 'invoiced')]"/>
                <filter name="paid_basis" string="Paid Basis" domain="[('revenue_basis', '=', 'paid')]"/>
                <group>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'date_month'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_bonus_grid" model="ir.actions.act_window">
        <field name="name">Bonus Grids</field>
        <field name="res_model">sales.bonus.grid</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sales_bonus_grid_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first monthly bonus grid!
            </p>
            <p>
                Configure monthly revenue thresholds and corresponding bonus amounts or percentages.
                New months will automatically inherit the previous month's tiers if not customized.
            </p>
        </field>
    </record>
</odoo>
