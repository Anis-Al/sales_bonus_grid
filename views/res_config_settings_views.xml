<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sales_bonus" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sales.bonus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Sales Bonus Tracker" name="sales_bonus_grid_setting_container">
                    <setting id="bonus_auto_refresh_setting" string="Auto Refresh Statements" help="Automatically recalculate open statements every hour via cron.">
                        <field name="bonus_auto_refresh"/>
                    </setting>
                    <setting id="bonus_lock_day_setting" string="Monthly Statement Lock Day" help="Day of the following month (1-28) when previous month statements are automatically locked.">
                        <field name="bonus_lock_day" class="oe_inline"/>
                    </setting>
                    <setting id="bonus_default_basis_setting" string="Default Revenue Basis" help="Default revenue recognition mode for newly generated monthly grids.">
                        <field name="bonus_default_revenue_basis"/>
                    </setting>
                    <setting id="bonus_default_mode_setting" string="Default Calculation Mode" help="Default calculation rule (Cliff or Progressive) for newly generated monthly grids.">
                        <field name="bonus_default_mode"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
